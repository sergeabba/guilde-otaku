# Modele de configuration. Copier en .env.local (jamais commite) et remplir
# les valeurs soi-meme. Ne jamais mettre de vraie valeur dans ce fichier.
# Sur Vercel : Project > Settings > Environment Variables.

# --- Administration (cote serveur uniquement, jamais de prefixe NEXT_PUBLIC_) ---
# Phrase de passe unique, au moins 12 caracteres. La valeur 1111 est refusee.
ADMIN_PASSWORD=
# Conseille : chaine aleatoire d'au moins 32 caracteres, distincte du mot de passe.
# La changer deconnecte toutes les sessions admin ouvertes.
ADMIN_SESSION_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=
# Cle serveur, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Services externes ---
TMDB_API_KEY=

# --- Recette locale uniquement (ignore en production) ---
# GUILDE_EXTRAS_FIXTURE=tests/fixtures/extras.local-qa.json
